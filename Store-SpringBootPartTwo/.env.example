# Copy to .env and replace placeholders with your local configuration.
DB_URL=jdbc:mysql://localhost:3306/store_api?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
# At least 32 random bytes for the HMAC signing key.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
